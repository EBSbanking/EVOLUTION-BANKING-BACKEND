{
  "name": "evolution-core-x-banking-backend",
  "version": "2.0.0",
  "description": "Evolution Core X Banking Backend API - Full MySQL/Sequelize Migration with Legacy Support - Optimized for 1000+ Concurrent Users",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev:full": "concurrently \"npm run dev:single\" \"cd admin-ui && npm start\"",
    "dev": "pm2 start server.js -i max --name evolution-backend && pm2 logs",
    "dev:single": "node server.js",
    "dev:cluster": "pm2 start server.js -i max --name evolution-backend",
    "dev:stop": "pm2 stop evolution-backend",
    "dev:delete": "pm2 delete evolution-backend",
    "dev:restart": "pm2 restart evolution-backend",
    "dev:logs": "pm2 logs evolution-backend",
    "dev:monit": "pm2 monit",
    "start": "NODE_ENV=production CLUSTER_MODE=true node server.js",
    "start:full": "cd admin-ui && npm run build && xcopy build ..\\public\\admin /E /I /Y && cd .. && node server.js",
    "start:single": "NODE_ENV=production node server.js",
    "start:cluster": "NODE_ENV=production CLUSTER_MODE=true node server.js",
    "start:legacy": "node cluster.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:pm2:restart": "pm2 restart evolution-backend",
    "start:pm2:stop": "pm2 stop evolution-backend",
    "start:pm2:logs": "pm2 logs evolution-backend",
    "start:pm2:monit": "pm2 monit",
    "prod": "NODE_ENV=production CLUSTER_MODE=true node server.js",
    "prod:single": "NODE_ENV=production node server.js",
    "prod:debug": "NODE_ENV=production DEBUG=* node server.js",
    "eod-loan-repayment": "node scripts/eodLoanRepayment.js --run-eod",
    "eod-interest-accrual": "node scripts/eodInterestAccrual.js",
    "eod-savings-interest": "node scripts/eodSavingsInterest.js",
    "eod-fees-penalties": "node scripts/eodFeesAndPenalties.js",
    "eod-generate-statements": "node scripts/eodGenerateStatements.js",
    "eod-daily-summary": "node scripts/eodDailySummary.js",
    "eod-close-business-day": "node scripts/eodCloseBusinessDay.js",
    "test": "NODE_ENV=test jest --detectOpenHandles --maxWorkers=50%",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:db": "node scripts/test-db-connection.js",
    "test:mocha": "NODE_ENV=test mocha tests/**/*.test.js --timeout 10000",
    "test:mocha:watch": "NODE_ENV=test mocha tests/**/*.test.js --watch --timeout 10000",
    "test:load": "node scripts/load-test.js",
    "test:stress": "node scripts/stress-test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:fix": "npm audit fix",
    "db:setup": "node scripts/setup-mysql.js",
    "db:reset": "node scripts/reset-mysql.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:optimize": "node scripts/optimize-database.js",
    "db:pool:status": "node scripts/check-pool-status.js",
    "sequelize": "sequelize",
    "sequelize-init": "npx sequelize-cli init",
    "health": "node scripts/health-check.js",
    "health:detailed": "node scripts/detailed-health-check.js",
    "metrics": "curl http://localhost:9090/metrics",
    "docker:mysql": "docker run --name evolution-mysql -p 3306:3306 -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=core_banking -d mysql:8 --max-connections=500 --innodb-buffer-pool-size=2G",
    "docker:mysql:stop": "docker stop evolution-mysql && docker rm evolution-mysql",
    "docker:clean": "docker stop evolution-mysql 2>/dev/null; docker rm evolution-mysql 2>/dev/null; docker rmi mysql:8 2>/dev/null; echo 'Docker MySQL cleaned'",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "docker:redis": "docker run --name evolution-redis -p 6379:6379 -d redis --maxmemory 512mb --maxmemory-policy allkeys-lru",
    "docker:redis:stop": "docker stop evolution-redis && docker rm evolution-redis",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "clean:cache": "npm cache clean --force",
    "clean:logs": "rm -rf logs/*.log",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check:models": "node scripts/check-models.js",
    "check:performance": "node scripts/performance-check.js",
    "check:memory": "node scripts/memory-check.js",
    "generate:migration": "npx sequelize-cli migration:generate --name",
    "generate:model": "npx sequelize-cli model:generate --name",
    "generate:seed": "npx sequelize-cli seed:generate --name",
    "sync:force": "node scripts/force-sync-db.js",
    "sync:safe": "node scripts/safe-sync-db.js",
    "backup:db": "node scripts/backup-database.js",
    "backup:auto": "node scripts/auto-backup.js",
    "restore:db": "node scripts/restore-database.js",
    "api:docs": "node scripts/generate-api-docs.js",
    "api:validate": "node scripts/validate-api.js",
    "performance:test": "node scripts/performance-test.js",
    "performance:monitor": "node scripts/performance-monitor.js",
    "security:scan": "node scripts/security-scan.js",
    "security:audit": "npm audit --production",
    "deploy:setup": "node scripts/deployment-setup.js",
    "deploy:check": "node scripts/deployment-check.js",
    "monitor:start": "pm2 start ecosystem.config.js --only metrics",
    "monitor:stop": "pm2 stop metrics",
    "monitor:logs": "pm2 logs metrics",
    "logs:clean": "node scripts/clean-logs.js",
    "logs:archive": "node scripts/archive-logs.js",
    "update:deps": "npm update",
    "update:deps:major": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.21.0",
    "async-retry": "^1.3.3",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csvtojson": "^2.0.14",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.26.5",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "dockerode": "^5.0.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "express-status-monitor": "^1.2.3",
    "express-validator": "^7.2.0",
    "express-xml-bodyparser": "^0.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "http-proxy-middleware": "^3.0.5",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-business-days": "^1.2.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.17.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.3",
    "p-limit": "^7.3.0",
    "pdfkit": "^0.17.1",
    "pm2": "^5.4.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^4.7.0",
    "request": "^2.88.2",
    "sequelize": "^6.37.7",
    "sql.js": "^1.13.0",
    "sql.js-httpvfs": "^0.8.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.31.5",
    "uuid": "^11.1.0",
    "validator": "^13.9.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@types/node": "^20.17.10",
    "artillery": "^2.0.6",
    "chai": "^5.1.1",
    "concurrently": "^10.0.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "faker": "^5.5.3",
    "jest": "^29.6.1",
    "mocha": "^7.2.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.5.3",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.0.0"
  },
  "optionalDependencies": {
    "bull": "^4.16.5"
  },
  "engines": {
    "node": ">=18.0.0",
